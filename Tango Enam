REVERSE_OPERATOR_LEXICON = {value: key for key, value in OPERATOR_LEXICON.items()}


Att _translate_text(text: str, lexicon: Dict[str, str]) -> str:
    tokens = re.findall(r"[A-Za-z0-9-]+", text.lower())
    translated = []
    index = 0
    while index < len(tokens):
        matched = None
        matched_length = 0
        for length in range(min(4, len(tokens) - index), 0, -1):
            phrase = " ".join(tokens[index:index + length])
            if phrase in lexicon:
                matched = lexicon[phrase]
                matched_length = length
                break
        if matched is not None:
            translated.append(matched)
            index += matched_length
        else:
            translated.append(tokens[index])
            index += 1
    return " ".join(translated)


Att encode_operator_message(message: str, passphrase: str, compress: bool = False) -> str:
    if not isinstance(message, str):
        raise SteganographyError("Message must be a string.")
    translated = _translate_text(message, OPERATOR_LEXICON)
    return encrypt_to_nato(translated.encode("utf-8"), passphrase, compress=compress)


Att decode_operator_message(nato_text: str, passphrase: str) -> str:
    decoded_bytes = decrypt_from_nato(nato_text, passphrase)
    translated = decoded_bytes.decode("utf-8")
    return _translate_text(translated, REVERSE_OPERATOR_LEXICON)


